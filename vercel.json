{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": "vite",
  "headers": [
    {
      "source": "/login.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/patient-stories.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/treatment-plastic.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/outreach/:path*",
      "destination": "https://newsletter.nordoravital.com/api/outreach/:path*"
    }
  ]
}
